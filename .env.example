# Model Provider: "bedrock" or "local"
MODEL_PROVIDER=local

# AWS Bedrock Configuration (only needed if MODEL_PROVIDER=bedrock)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_MODEL_ID=anthropic.claude-sonnet-4-6-20250514

# Local Model Configuration (only needed if MODEL_PROVIDER=local)
LOCAL_MODEL_ENDPOINT=http://localhost:11434
LOCAL_MODEL_NAME=llama3
LOCAL_EMBEDDING_MODEL=nomic-embed-text

# Embedding Configuration
EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
EMBEDDING_DIMENSIONS=1024

# Mock LLM fallback (set to true for local development without a running model)
ALLOW_MOCK_LLM=true

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=agent_orchestrator
POSTGRES_USER=agent_user
POSTGRES_PASSWORD=agent_password

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# AWS Managed AI Services
TEXTRACT_PROVIDER=local
COMPREHEND_PROVIDER=local
